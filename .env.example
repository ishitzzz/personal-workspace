# GEMINI_API_KEY: Required for fallback/chat capabilities using Google's Gemini models.
# AI Studio automatically injects this at runtime from user secrets.
# In Render, you can enter your Google Gemini API key here.
GEMINI_API_KEY="your_gemini_api_key_here"

# GROQ_API_KEY: Required for high-speed LLaVA vision analysis and Llama 3 chat.
# If not specified, the system will fall back to hardcoded keys in server.ts as a backup pool.
GROQ_API_KEY="your_groq_api_key_here"

# CLOUD DATABASE STORAGE (Highly Recommended for Serverless/Vercel/Render!):
# Overcomes Render's 15-minute container inactivity resets & Vercel's stateless functions.
# Simply enable Vercel KV OR configure a free Upstash Redis database and paste the connection strings here:
UPSTASH_REDIS_REST_URL="your_upstash_redis_rest_url_here"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# VERCEL KV Alternative variables (will map automatically if present):
KV_REST_API_URL="your_vercel_kv_rest_api_url_here"
KV_REST_API_TOKEN="your_vercel_kv_rest_api_token_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
